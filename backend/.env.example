# WhistleDrop Backend Environment Variables Template
# Copy this file to .env for local development

# ==============================================================================
# Database Configuration (PostgreSQL for Production, SQLite for Local Dev)
# ==============================================================================
# Local Development (SQLite):
# DATABASE_URL=sqlite:///./whistledrop.db

# Production Supabase PostgreSQL (Use Transaction Pooler on port 6543 for IPv4 compatibility on Render):
# Format: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# (Note: URLs starting with postgresql:// or postgres:// are automatically normalized to postgresql+psycopg://)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/whistledrop

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Exact variable name: JWT_SECRET (do NOT use JWT_SECRET_KEY)
# Generate a cryptographically strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Server-side secret key for HMAC-SHA256 case code hashing
# Exact variable name: CASE_CODE_SALT (do NOT use CASE_CODE_HMAC_SECRET)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CASE_CODE_SALT=replace_with_a_random_secret_key_in_production

# ==============================================================================
# Application & CORS Settings
# ==============================================================================
ENVIRONMENT=development
PROJECT_NAME="WhistleDrop API"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Frontend URL for production CORS configuration (e.g. Vercel deployment URL)
# Value must start with https:// and have NO trailing slash
# FRONTEND_URL=https://whistle-drop-two.vercel.app

# ==============================================================================
# Object Storage (Supabase Storage for Private Evidence Files)
# ==============================================================================
# STORAGE_PROVIDER: "auto", "supabase", or "local" (default: "auto")
# STORAGE_PROVIDER=auto

# Provide Supabase credentials for production cloud storage:
# Exact variable name: SUPABASE_SERVICE_ROLE_KEY (do NOT use SUPABASE_SECRET_KEY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=whistledrop-evidence

# ==============================================================================
# Emergency Admin Password Reset / Provisioning (Render Without Shell)
# ==============================================================================
# Generate a strong 32+ character secret to enable POST /api/v1/admin/recovery/reset-password
# Once initial admin access is confirmed, remove this variable from Render
# ADMIN_RECOVERY_SECRET=replace_with_temporary_secret_for_emergency_admin_reset

