# WhistleDrop Backend Environment Variables Template
# Copy this file to .env for local development

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://username:password@hostname:port/database_name
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/whistledrop

# Authentication & Security
# Generate a cryptographically strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional server-side pepper for hashing case codes (extra layer of defense)
CASE_CODE_SALT=replace_with_a_random_salt_in_production

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="WhistleDrop API"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Private Object Storage (Evidence Files)
# Provide Supabase credentials for production cloud storage,
# or leave unset to use automatic local filesystem fallback (e.g., in local dev and tests)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=whistledrop-evidence
# STORAGE_LOCAL_FALLBACK_DIR=storage_evidence
