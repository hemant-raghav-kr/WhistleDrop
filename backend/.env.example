# WhistleDrop Backend Environment Variables Template
# Copy this file to .env for local development

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://username:password@hostname:port/database_name
# (Note: Supabase pooled or direct URLs like postgresql://... or postgres://... are automatically normalized)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/whistledrop

# Authentication & Security
# Generate a cryptographically strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server-side secret key for HMAC-SHA256 case code hashing
CASE_CODE_SALT=replace_with_a_random_secret_key_in_production

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="WhistleDrop API"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Frontend URL for production CORS configuration (e.g. Vercel deployment URL)
# FRONTEND_URL=https://<your-app>.vercel.app

# Storage Provider: "auto", "supabase", or "local" (default: "auto")
# STORAGE_PROVIDER=supabase

# Private Object Storage (Evidence Files)
# Provide Supabase credentials for production cloud storage,
# or leave unset to use automatic local filesystem fallback (e.g., in local dev and tests)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=whistledrop-evidence
# STORAGE_LOCAL_FALLBACK_DIR=.evidence_storage
